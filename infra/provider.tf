# ============================================================
# Terraform本体とAWSプロバイダの基本設定
#   このファイルは「Terraformをどう動かすか」の土台を決める。
#   リソース（VPCやRDSなど）はここには書かず、別ファイルに分ける。
# ============================================================

# terraform ブロック: Terraform自身に関する設定を書く場所
terraform {
  # 【なぜ書くか】required_version = このコードを動かすのに必要なTerraform本体のバージョン下限
  #   → 今回importブロック（既存リソースを取り込む書き方）を使うが、
  #     これはTerraform 1.5から入った機能。1.5未満のTerraformで実行されると
  #     importブロックが解釈できずエラーになるため、下限を明示して事故を防ぐ。
  required_version = ">= 1.5"

  # 【なぜ書くか】required_providers = どのプロバイダ(=クラウドを操作するプラグイン)を使うか宣言
  #   → providerブロック(下)だけでもAWSは動くが、バージョンを固定しないと
  #     別のPCやCIで実行したときに勝手に新しいバージョンが入り、挙動が変わって
  #     差分が出ることがある。source と version を固定して再現性を保つ。
  required_providers {
    aws = {
      # source: プラグインの入手元。hashicorp/aws = HashiCorp公式のAWSプロバイダ
      source = "hashicorp/aws"
      # version: "~> 5.0" は「5.x系の中の最新を使う（6.0には上げない）」の意味。
      #   ~> は「メジャーバージョンは固定、マイナー以下は許容」を表す記号（悲観的バージョン制約）。
      #   メジャーが上がると破壊的変更が入りうるので、意図せず6系に上がらないようにしている。
      version = "~> 5.0"
    }
  }
}

# provider ブロック: 実際にAWSをどう操作するかの設定
#   【なぜ region だけか】認証情報(アクセスキー等)はここに書かない。
#     ローカルの ~/.aws/credentials や環境変数から自動で読まれるため、
#     コードに秘密情報を書かずに済む（Gitに漏らさないためにも直書きしない）。
provider "aws" {
  region = "ap-northeast-1" # 東京リージョン。既存リソースが全てここにあるため合わせる
}
